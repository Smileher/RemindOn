{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "updater",
  "description": "Allow the main window to update RemindOn and open its website or Store updates",
  "windows": ["main"],
  "permissions": [
    "updater:default",
    "process:allow-restart",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://smileher.github.io/RemindOn/" },
        { "url": "https://smileher.github.io/RemindOn/en/" },
        { "url": "https://smileher.github.io/RemindOn/#download" },
        { "url": "https://smileher.github.io/RemindOn/en/#download" },
        { "url": "ms-windows-store://pdp/?productid=9P9K31N2CJBW" }
      ]
    }
  ]
}
