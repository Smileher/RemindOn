{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RemindOn",
  "version": "1.1.0",
  "identifier": "com.remindon.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwQjFERTI5MkYxRkJCMQpSV1N4Ky9HUzRoMExDczFlc2UwbWQyM3FFbDd5QUdDVnhOamlRcDI3YWtNMGpYMDZqaUU0bjV0Kwo=",
      "endpoints": [
        "https://github.com/Smileher/RemindOn/releases/latest/download/latest.json",
        "https://gitee.com/smileher/RemindOn/releases/download/latest/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "publisher": "Smileher",
    "copyright": "Copyright © 2026 Smileher",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
