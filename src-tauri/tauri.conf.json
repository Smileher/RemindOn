{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RemindOn",
  "version": "0.7.0",
  "identifier": "com.remindon.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RemindOn",
        "width": 780,
        "height": 540,
        "minWidth": 780,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "reminder",
        "title": "RemindOn",
        "url": "index.html#/reminder",
        "width": 520,
        "height": 320,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwQjFERTI5MkYxRkJCMQpSV1N4Ky9HUzRoMExDczFlc2UwbWQyM3FFbDd5QUdDVnhOamlRcDI3YWtNMGpYMDZqaUU0bjV0Kwo=",
      "endpoints": [
        "https://github.com/Smileher/RemindOn/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg"],
    "publisher": "ChenHe",
    "copyright": "Copyright © 2026 ChenHe",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
