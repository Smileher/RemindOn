{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "label": "RemindOn: 开发运行（热更新）",
      "type": "shell",
      "command": "pnpm",
      "args": ["tauri:dev"],
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "RemindOn: 构建 Debug 可执行文件",
      "type": "shell",
      "command": "pnpm",
      "args": ["tauri:build", "--debug", "--no-bundle"],
      "detail": "构建含前端资源的 Debug 可执行文件，供 CodeLLDB 调试；不生成安装包，无热更新。macOS 产物为 src-tauri/target/debug/remindon，Windows 为 remindon.exe。",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "RemindOn: 构建 Windows 便携版",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "./scripts/build-portable.ps1"],
      "detail": "构建 x64 便携 ZIP 和 ZIP 的 SHA-256，输出到 src-tauri/target/portable/<版本>/。",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "RemindOn: 构建 Windows 安装版",
      "type": "shell",
      "command": "pnpm",
      "args": ["tauri:build", "--bundles", "nsis", "--no-sign", "--ci"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "RemindOn: 构建 macOS 安装版（在 Mac 上运行）",
      "type": "shell",
      "command": "pnpm",
      "args": ["tauri:build", "--bundles", "app,dmg", "--no-sign", "--ci"],
      "detail": "产出 .app 与 .dmg。DMG 排版需调用 Finder，首次执行请在弹窗中允许控制 Finder。",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "RemindOn: 构建 Store 上传包",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "./scripts/build-store.ps1"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "RemindOn: 构建 Store 双架构上传包（需 ARM64 MSVC/Clang）",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "./scripts/build-store.ps1", "-AllArchitectures"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "RemindOn: 构建 Store 上传包和本机测试包",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "./scripts/build-store.ps1", "-LocalTest"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "RemindOn: 构建 macOS 快速包（仅 .app，约 2 分钟）",
      "type": "shell",
      "command": "pnpm",
      "args": ["tauri:build", "--bundles", "app", "--no-sign", "--ci"],
      "detail": "仅产出 RemindOn.app，不做 DMG 排版因此无需 Finder 自动化权限，速度最快，适合本机验证。",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "RemindOn: 更新应用图标",
      "type": "shell",
      "command": "pnpm",
      "args": ["tauri", "icon", "src/assets/remindon.svg"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
