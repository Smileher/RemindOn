{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RemindOn: 开发运行（热更新）",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm tauri:dev",
      "cwd": "${workspaceFolder}",
      "autoAttachChildProcesses": false
    },
    {
      "name": "RemindOn: Rust 断点调试（Debug EXE）",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/src-tauri/target/debug/remindon.exe",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "RemindOn: 构建 Debug EXE",
      "sourceLanguages": ["rust"],
      "env": {
        "RUST_BACKTRACE": "1"
      }
    }
  ]
}
